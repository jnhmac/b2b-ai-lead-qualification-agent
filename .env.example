# Names only. Every value here is empty on purpose; fill them in a local .env,
# which is gitignored. Keys are read at point of use, so the offline test suite
# runs with none of them set, and each `require_*` accessor names the missing
# variable exactly.

FIRECRAWL_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
APOLLO_API_KEY=

LLM_PROVIDER=openrouter        # openrouter | anthropic
STORE_BACKEND=local            # local | gcs
STORE_ROOT=./data              # local path, or gs://bucket[/prefix] for gcs
